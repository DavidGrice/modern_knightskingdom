#!/bin/sh
# Local guard rail. Enable with:  git config core.hooksPath .githooks
#
# The real enforcement is the ruleset on GitHub (see CONTRIBUTING.md); this
# just catches the mistake before it costs a round trip. Bypass with
# `git push --no-verify` when you genuinely mean it.

remote_ref_prefix='refs/heads/'
fail=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch=${remote_ref#$remote_ref_prefix}

  # 1 · never push straight to main
  if [ "$branch" = "main" ]; then
    echo "pre-push: refusing to push directly to main." >&2
    echo "          Branch, push, and open a PR — see CONTRIBUTING.md." >&2
    fail=1
    continue
  fi

  # 2 · the branch name CI will check for, checked here first
  if ! echo "$branch" | grep -Eq '^(feature|enhancement|bugfix|chore|docs)/[a-z0-9._-]+$'; then
    echo "pre-push: '$branch' does not match <type>/<slug>." >&2
    echo "          Types: feature, enhancement, bugfix, chore, docs." >&2
    fail=1
  fi
done

[ "$fail" = "1" ] && exit 1

# 3 · the typecheck, so CI is not the thing that tells you about a typo.
# The build is left to CI: it is slow, and it rarely fails once tsc passes.
echo "pre-push: typechecking..."
if ! npx tsc --noEmit; then
  echo "pre-push: tsc failed — fix it or push with --no-verify." >&2
  exit 1
fi

exit 0
